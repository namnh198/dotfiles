{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make build)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(lodev *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git add *--force*)",
      "Bash(git add -f *)",
      "Bash(git add * -f)",
      "Bash(git add * -f *)",
      "Bash(git commit *--amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(gh secret *)",
      "Bash(gh release *)",
      "Bash(git tag *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git *core.hooksPath*)",
      "Bash(rsync *)",
      "Read(**/app/etc/env.php)",
      "Edit(**/app/etc/env.php)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Bash(lodev db-import*)",
      "Bash(lodev start*)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "code-review@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "mattpocock-skills@synced": false,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 500000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 500000
    }
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": false,
        "sendNames": true
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "agentPushNotifEnabled": true
}
