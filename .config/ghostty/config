term = xterm-256color
#theme = catppuccin-mocha.conf
theme = Catppuccin Mocha
cursor-color = f5e0dc
cursor-text = 1e1e2e
cursor-style = block
#font-family = "OperatorMonoSSmLig Nerd Font"
font-family = JetBrainsMono Nerd Font
font-size = 13
font-thicken = true
cursor-style = block
cursor-style-blink = true
adjust-cell-height = 20%
adjust-cursor-thickness = 2
#background-image = "/Users/namnh198/Developer/dotfiles/wallpapers/nixos-waifu-2.png"
#background-image-opacity = 0.15
#background-image-fit = cover
background-blur = macos-glass-regular
background-opacity = 0.90
background-blur-radius = 20

#window-decoration = none
window-padding-x = 16
window-padding-y = 8
mouse-hide-while-typing = true
macos-window-shadow = true
macos-option-as-alt = true
macos-icon = xray
macos-titlebar-style = hidden
unfocused-split-opacity = 0.6
window-padding-balance = true
keybind = ctrl+shift+m=toggle_maximize
keybind = alt+backspace=text:\x1b\x7f
