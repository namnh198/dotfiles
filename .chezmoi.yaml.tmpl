{{- $email := "" -}}
{{- if hasKey . "email" -}}
{{-   $email = .email -}}
{{- else -}}
{{-   $email = promptString "Email address" -}}
{{- end -}}

{{- $username := "" -}}
{{- if hasKey . "username" -}}
{{-   $username = .username -}}
{{- else -}}
{{-   $username = promptString "Username" -}}
{{- end -}}

{{- $system := "" -}}
{{- if hasKey . "system" -}}
{{-   $system = .system -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{    $system = "desktop" -}}
{{- else -}}
{{-   $system = promptString "System (desktop or server)" -}}
{{- end -}}

data:
  email: {{ $email | quote }}
  username: {{ $username | quote }}
  system: {{ $system | quote }}

diff:
  pager: delta
