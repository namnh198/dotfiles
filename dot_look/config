# look configuration
# Generated on first launch. Edit values and press Cmd+Shift+; to reload.

# Backend indexing
app_scan_roots=/Applications,/System/Applications,/System/Applications/Utilities,/System/Library/CoreServices/Applications,/System/Library/CoreServices/Finder.app/Contents/Applications,~/Applications
app_scan_depth=3
app_exclude_paths=
app_exclude_names=Claude Code URL Handler
file_scan_roots=Desktop,Documents,Downloads,Developer
file_scan_extra_roots=
file_scan_depth=5
file_scan_limit=8000
lazy_indexing_enabled=true
backend_log_level=error
launch_at_login=true
skip_dir_names=node_modules,target,build,dist,library,applications,old firefox data,deriveddata,pods,vendor,out,coverage,tmp,cache,venv

# UI theme
ui_theme=catppuccin
ui_tint_red=0.11
ui_tint_green=0.11
ui_tint_blue=0.18
ui_tint_opacity=0.58
ui_blur_material=sidebar
ui_blur_opacity=0.94
ui_font_name=SF Pro Text
ui_font_size=14
ui_font_red=0.95
ui_font_green=0.94
ui_font_blue=0.98
ui_font_opacity=0.97
ui_border_thickness=1.00
ui_border_red=0.80
ui_border_green=0.75
ui_border_blue=0.93
ui_border_opacity=0.20

# Running apps switcher: none, top, right, bottom
running_apps_placement=right

# Search aliases (apps + System Settings). Format: alias_<keyword>=Term1|Term2|Term3
alias_note=Notion|Obsidian|Notes|Apple Notes|Bear|Logseq
alias_code=Visual Studio Code|VSCode|Cursor|Windsurf|IntelliJ IDEA|PyCharm|WebStorm|Neovim|Xcode|Zed
alias_term=Terminal|iTerm|iTerm2|Ghostty|WezTerm|Alacritty|Kitty|Warp
alias_te=Ghostty|Wezterm|Terminal
alias_chat=Slack|Discord|Telegram|Messages
alias_music=Spotify|Apple Music|Music
alias_brow=Safari|Arc|Google Chrome|Chrome|Firefox|Brave|Dia|Ardia
alias_ai=Claude
ignored_patterns_sample=
clipboard_history_limit=10

# AI
ai_enabled=true
ai_provider=appleIntelligence
ai_allow_remote_context=false
ollama_host=http://localhost:11434
ollama_model=gemma4:e4b-mlx

# Added by look update
localized_app_names=false
inner_gap=10
super_actions_enabled=true
query_retention_seconds=5
launcher_hotkey=cmd+space
hints_enabled=true
search_placeholder=Type whatever you want
translate_languages=vi,en,ja

# Added by look update
file_exclude_paths=
settings_blur_multiplier=0.60
layout=split
ui_surface_radius=1.50
animations_enabled=true

text_editor=nvim
code_editor=zed
terminal=ghostty
file_manager=nautilus
