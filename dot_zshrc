#!/usr/bin/env zsh

export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_STATE_HOME="${HOME}/.local/state"
export EDITOR="nvim"
export VISUAL="nvim"
export GOPATH="${XDG_DATA_HOME:-${HOME}/.local/share}/go"
export BAT_THEME="Catppuccin Mocha"
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=600000
export LS_COLORS="rs=0:di=01;34:ln=01;36:mh=00:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:mi=00:su=37;41:sg=30;43:ca=30;41:tw=30;42:ow=34;42:st=37;44:ex=01;32:\
*.tar=01;31:*.zip=01;31:*.7z=01;31:*.rar=01;31:*.gz=01;31:\
*.txt=00;37:*.md=01;38;5;156:\
*.js=01;38;5;221:*.jsx=01;38;5;221:*.ts=01;38;5;111:*.tsx=01;38;5;111:\
*.html=01;38;5;111:*.css=01;38;5;115:*.scss=01;38;5;115:\
*.jpg=01;35:*.png=01;35:*.svg=01;35:*.ico=01;35:\
*.yaml=01;38;5;215:*.yml=01;38;5;215:*.toml=01;38;5;147:*.xml=01;38;5;115:*.json=01;38;5;115:\
*.sql=01;38;5;111:*.csv=01;38;5;115:*.pdf=01;31:\
*rc=01;38;5;147:*_profile=01;38;5;147:*_history=00;38;5;245:*.DS_Store=00;38;5;245:*.zcompdump*=00;38;5;245:\
*.sh=01;38;5;147:*.bash=01;38;5;147:*.zsh=01;38;5;147:*.fish=01;38;5;147:*.alias=01;38;5;147:\
*.gitignore=00;38;5;245:.git=01;38;5;203:Dockerfile=01;38;5;111:docker-compose.yml=01;38;5;215:"
export FZF_TMUX=true
export FZF_CTRL_T_COMMAND="fd --type f --hidden"
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always --line-range :500 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always --group-directories-first {} | head -200'"
export FZF_ALT_C_COMMAND="fd --type d"

HISTSIZE=50000
SAVEHIST=$HISTSIZE
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups
setopt GLOB_DOTS

if [[ -d "$HOME/.local/bin" ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Cache the output of slow `tool init`-style commands and source the cached
# (and zcompiled) copy. Regenerated automatically when the binary is updated.
#   _cache_eval <name> <command> [args...]
_cache_eval() {
  local name=$1; shift
  local bin=${commands[$1]:-$1}
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/${name}.zsh"
  if [[ ! -s $cache || $bin -nt $cache ]]; then
    mkdir -p "${cache:h}"
    "$@" >| "$cache" 2>/dev/null
    zcompile "$cache"
  fi
  source "$cache"
}

if [[ -f "/opt/homebrew/bin/brew" ]]; then
  # macOS (Apple Silicon)
  _cache_eval brew-shellenv /opt/homebrew/bin/brew shellenv
fi

if [[ -d "${XDG_DATA_HOME:-${HOME}/.local/share}/zsh/site-functions" ]]; then
  FPATH="${XDG_DATA_HOME:-${HOME}/.local/share}/zsh/site-functions:${FPATH}"
fi

# ---------------------------------------------------------------------------
# zinit
# ---------------------------------------------------------------------------
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

# Fast compinit: -C skips the fpath security scan + dump regeneration.
# After adding/removing completion plugins run: rm -f ~/.zcompdump* && exec zsh
typeset -gA ZINIT
ZINIT[COMPINIT_OPTS]=-C

autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# starship (prompt: loaded immediately, not turbo)
zinit ice as"command" from"gh-r" \
  atclone"./starship init zsh > init.zsh; ./starship completions zsh > _starship" \
  atpull"%atclone" src"init.zsh"
zinit light starship/starship

# Turbo block. Order matters:
#   1. completion sources (add to fpath)
#   2. compinit (atinit of fzf-tab) + replay of queued compdefs
#   3. fzf-tab (after compinit, before widget-wrapping plugins)
#   4. autosuggestions, then syntax highlighting (last)
zinit light-mode wait lucid for \
  blockf atpull'zinit creinstall -q .' \
    zsh-users/zsh-completions \
    wbingli/zsh-claudecode-completion \
  atinit"zicompinit; zicdreplay" \
    Aloxaf/fzf-tab \
  atload"_zsh_autosuggest_start" \
    zsh-users/zsh-autosuggestions \
    zdharma-continuum/fast-syntax-highlighting

# Snippets (turbo, after the block above)
zinit light-mode wait lucid for \
  OMZP::command-not-found \
  https://raw.githubusercontent.com/catppuccin/fzf/refs/heads/main/themes/catppuccin-fzf-mocha.sh

# ---------------------------------------------------------------------------
# Completion styles
# ---------------------------------------------------------------------------
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --all --group-directories-first $realpath'
zstyle ':fzf-tab:complete:text-editors:*' fzf-preview 'bat --color=always $realpath'
zstyle ':fzf-tab:complete:cd:*' popup-pad 50 0
zstyle ':fzf-tab:*' popup-min-size 50 8
zstyle ':fzf-tab:*' fzf-flags --color=fg:1,fg+:2 --bind=tab:accept
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup

zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"

# Cached tool init (saves ~50-150ms of forks per shell start)
_cache_eval zoxide zoxide init zsh --cmd cd
_cache_eval mise   mise activate zsh
_cache_eval fzf    fzf --zsh

bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^p' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region

# ---------------------------------------------------------------------------
# Aliases & functions (moved from .zprofile so they load in every interactive
# shell, including non-login shells like tmux panes, without double-sourcing)
# ---------------------------------------------------------------------------
alias c='clear'
alias g='git'
alias tm='tmux'
alias lz='lazygit'
alias chez='chezmoi'
alias ..='cd ..'
alias eza='eza --icons=always --color=always --group-directories-first --header'
alias la='eza -a'
alias ll='eza -la'
alias lt='eza --tree'
alias vimdiff='nvim -d'
alias vim='nvim'
alias vi='nvim'

ide() {
  local session="${1:-${PWD:t}}"

  # tmux session names should not contain "." or ":"
  session="${session//[.: ]/_}"

  if tmux has-session -t "$session" 2>/dev/null; then
    if [[ -n "$TMUX" ]]; then
      tmux switch-client -t "$session"
    else
      tmux attach-session -t "$session"
    fi
  else
    if [[ -n "$TMUX" ]]; then
      tmux new-session -d -s "$session" -c "$PWD"
      tmux switch-client -t "$session"
    else
      tmux new-session -s "$session" -c "$PWD"
    fi
  fi
}
